generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String     @id @default(cuid())
  name       String
  createdAt  DateTime   @default(now())
  slug       String     @unique
  updatedAt  DateTime   @updatedAt
  tenantCode String     @unique
  customers  Customer[]
  orders     Order[]
  payments   Payment[]
  products   Product[]

  @@index([slug])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model Product {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  description String?
  sku         String?
  image       String?
  size        String?
  price       Decimal     @db.Decimal(10, 2)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, sku])
}

model Order {
  id              String        @id @default(cuid())
  tenantId        String
  reference       String
  totalAmount     Decimal       @db.Decimal(10, 2)
  trackingNumber  String?
  createdAt       DateTime      @default(now())
  customerId      String?
  deliveryAddress String?
  paymentStatus   PaymentStatus @default(PENDING)
  shippingFee     Decimal       @db.Decimal(10, 2)
  shippingMethod  String?
  subtotal        Decimal       @db.Decimal(10, 2)
  updatedAt       DateTime      @updatedAt
  status          OrderStatus   @default(PENDING_PAYMENT)
  customer        Customer?     @relation(fields: [customerId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payments        Payment[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                    String          @id @default(cuid())
  tenantId              String
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  amount                Decimal         @db.Decimal(10, 2)
  orderId               String?
  createdAt             DateTime        @default(now())
  completedAt           DateTime?
  currency              String          @default("ZAR")
  provider              PaymentProvider
  providerReference     String?
  status                PaymentStatus   @default(PENDING)
  transactionReference  String?
  providerOptional1     String?
  providerOptional2     String?
  providerOptional3     String?
  providerOptional4     String?
  providerOptional5     String?
  providerStatusMessage String?
  updatedAt             DateTime        @updatedAt
  order                 Order?          @relation(fields: [orderId], references: [id])
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, orderId])
  @@index([transactionReference])
  @@index([providerReference])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  OZOW
  PAYFAST
  PAYSTACK
  MANUAL
}
